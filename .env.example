# Optional. Without either key, runs use the local scripted adapter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai/computer-use-preview | anthropic/claude-sonnet-4-5 | local/scripted
WORKSTATE_DEFAULT_MODEL=
WORKSTATE_HOME=
WORKSTATE_HOST=127.0.0.1
WORKSTATE_PORT=4780
# Set to docker to launch workstate/runtime:0.1 instead of in-process Playwright.
WORKSTATE_RUNTIME=local
# Set to 0 to show the Chromium window.
WORKSTATE_HEADLESS=1
