# Optional. ANCHOR_API_KEY makes Anchor the default runtime and native model.
# Without it, Workstate falls back to local Chromium and local/scripted.
ANCHOR_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
BROWSER_USE_API_KEY=
# local/scripted | openai/computer-use-preview | anthropic/claude-sonnet-4-5 | gemini/gemini-3.8-flash
# stagehand/<provider>/<model> | browser-use/cloud | browser-harness/<provider>/<model>
WORKSTATE_DEFAULT_MODEL=
WORKSTATE_MAX_STEPS=40
# Path to the browser-harness CLI if it is not on PATH.
WORKSTATE_BROWSER_HARNESS_BIN=

WORKSTATE_HOME=
WORKSTATE_HOST=127.0.0.1
WORKSTATE_PORT=4780
# Optional override. Leave blank for Anchor-when-configured, otherwise local:
# local | docker | anchor | browserbase | steel | kernel | e2b | daytona
WORKSTATE_RUNTIME=
# Set to 0 to show the Chromium window (local runtime).
WORKSTATE_HEADLESS=1

# Docker, E2B, and Daytona run this image (packages/runtime-docker/Dockerfile).
WORKSTATE_RUNTIME_IMAGE=workstate/runtime:0.1

# Hosted browsers
WORKSTATE_ANCHOR_PROFILE=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
WORKSTATE_BROWSERBASE_CONTEXT_ID=
STEEL_API_KEY=
STEEL_API_URL=
KERNEL_API_KEY=
WORKSTATE_KERNEL_PROFILE=

# Sandboxes
E2B_API_KEY=
WORKSTATE_E2B_TEMPLATE=workstate-runtime
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
WORKSTATE_DAYTONA_IMAGE=workstate/runtime:0.1
WORKSTATE_DAYTONA_SNAPSHOT=

# 1Password: a service account token (uses @1password/sdk) or a Connect server.
OP_SERVICE_ACCOUNT_TOKEN=
OP_CONNECT_HOST=
OP_CONNECT_TOKEN=

# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_API_URL=

# Agentcard
AGENTCARD_CLIENT_ID=
AGENTCARD_CLIENT_SECRET=
AGENTCARD_CARDHOLDER_ID=
