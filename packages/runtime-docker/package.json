{
  "name": "@workstate/runtime-docker",
  "version": "0.1.0",
  "description": "Optional Docker runtime for Workstate. The daemon inside the container wraps runtime-local.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@workstate/runtime-local": "workspace:*",
    "@workstate/sdk": "workspace:*",
    "hono": "^4.10.7"
  }
}
