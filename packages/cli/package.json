{
  "name": "workstate",
  "version": "0.1.0",
  "description": "Workstate CLI: start the control plane, run a task, and inspect environments.",
  "type": "module",
  "bin": {
    "workstate": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@workstate/model-adapters": "workspace:*",
    "@workstate/sdk": "workspace:*",
    "@workstate/server": "workspace:*"
  }
}
